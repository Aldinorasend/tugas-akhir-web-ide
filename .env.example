# =====================================================================
# PATHWISE MONOREPO — SEMUA ENV KEY (server + client) DI ROOT
# Salin jadi .env lalu isi nilainya. Satu file ini dipakai oleh:
#   - packages/server  (via src/config/env.js)
#   - packages/client  (via next.config.ts)
# =====================================================================

# ------------------------- Server (Express) -------------------------
PORT=4000
NODE_ENV=development

# JWT (WAJIB). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ------------------------- Supabase ---------------------------------
# Server-side & browser memakai project Supabase yang sama
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_ versi harus nilainya SAMA dengan di atas (dibutuhkan karena
# hanya var ber-prefix NEXT_PUBLIC_ yang ter-inline ke bundle browser Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------- Client (Next.js) -------------------------
# Base URL API server (tanpa trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000
